PORT=3000
NODE_ENV=development

MONGODB_URI=your-mongodb-uri
CLOUDINARY_URL=cloudinary://your-key:your-secret@your-cloud-name

SESSION_SECRET=change-me

ADMIN_USER=admin
ADMIN_PASS=admin

# Envoi des codes de verification par email (inscription).
# Sans ces variables, le code est affiche dans la console du serveur (pratique en local).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=mot-de-passe-application
MAIL_FROM="Dream Love <votre-adresse@gmail.com>"
